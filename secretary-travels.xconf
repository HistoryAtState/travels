<?xml version="1.0" encoding="UTF-8"?>
<collection xmlns="http://exist-db.org/collection-config/1.0">
    <index xmlns:frus="http://history.state.gov/frus/ns/1.0" xmlns:tei="http://www.tei-c.org/ns/1.0"
        xmlns:xs="http://www.w3.org/2001/XMLSchema">
        <lucene vector-store="db">
            <analyzer class="org.apache.lucene.analysis.standard.StandardAnalyzer">
                <!-- Specify stop words - or remove them entirely -->
                <param name="stopwords" type="org.apache.lucene.analysis.util.CharArraySet">
                    <!--<value>the</value>-->
                </param>
            </analyzer>
            <!-- Analyzer chains (eXist 7 lucene analyzer chains) for hsg-jinks's search
                 options. plain is the default field's: possessives dropped, words with
                 inner punctuation (F-16, S/S) indexed whole, in parts and joined,
                 lower-cased and folded. Each option leaves one step out: cased keeps
                 case; punct and literal keep punctuation inside words (literal keeps
                 case too); stemmed adds English (Porter) stemming. -->
            <analyzer id="plain">
                <index>
                    <tokenizer name="whitespace"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" catenateWords="1" catenateNumbers="1" catenateAll="1"/>
                    <filter name="flattenGraph"/>
                    <filter name="lowercase"/>
                    <filter name="asciiFolding"/>
                </index>
                <query>
                    <tokenizer name="whitespace"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" generateWordParts="0" generateNumberParts="0" catenateAll="1"/>
                    <filter name="lowercase"/>
                    <filter name="asciiFolding"/>
                </query>
            </analyzer>
            <analyzer id="cased">
                <index>
                    <tokenizer name="whitespace"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" catenateWords="1" catenateNumbers="1" catenateAll="1"/>
                    <filter name="flattenGraph"/>
                    <filter name="asciiFolding"/>
                </index>
                <query>
                    <tokenizer name="whitespace"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" generateWordParts="0" generateNumberParts="0" catenateAll="1"/>
                    <filter name="asciiFolding"/>
                </query>
            </analyzer>
            <analyzer id="punct">
                <tokenizer name="whitespace"/>
                <filter name="patternReplace" pattern="^[\p{P}\p{S}]+|[\p{P}\p{S}]+$" replacement=""/>
                <filter name="length" min="1" max="255"/>
                <filter name="lowercase"/>
                <filter name="asciiFolding"/>
            </analyzer>
            <analyzer id="literal">
                <tokenizer name="whitespace"/>
                <filter name="patternReplace" pattern="^[\p{P}\p{S}]+|[\p{P}\p{S}]+$" replacement=""/>
                <filter name="length" min="1" max="255"/>
                <filter name="asciiFolding"/>
            </analyzer>
            <analyzer id="stemmed">
                <tokenizer name="standard"/>
                <filter name="englishPossessive"/>
                <filter name="lowercase"/>
                <filter name="asciiFolding"/>
                <filter name="porterStem"/>
            </analyzer>
            <text index="no" qname="trips">
                <!-- start required facets and fields -->
                <facet dimension="hsg-category" expression="'department'"/>
                <facet dimension="hsg-publication" expression="'travels'"/>
                <field analyzer="plain" expression="trip/name, trip/country, trip/remarks, trip/locale"
                    name="hsg-fulltext" store="no"/>
                <field analyzer="stemmed" expression="trip/name, trip/country, trip/remarks, trip/locale"
                    name="hsg-fulltext-stemmed" store="no"/>
                <field analyzer="cased" expression="trip/name, trip/country, trip/remarks, trip/locale"
                    name="hsg-fulltext-cased" store="no"/>
                <field analyzer="punct" expression="trip/name, trip/country, trip/remarks, trip/locale"
                    name="hsg-fulltext-punct" store="no"/>
                <field analyzer="literal" expression="trip/name, trip/country, trip/remarks, trip/locale"
                    name="hsg-fulltext-literal" store="no"/>
                <vector-field name="hsg-embedding" expression="trip/name, trip/country, trip/remarks, trip/locale"
                    dimension="384" similarity="cosine"
                    embedding="local" model="all-MiniLM-L6-v2"/>
                <field
                    expression="'/departmenthistory/travels/secretary/' || util:document-name(.) =&gt; substring-before('.xml')"
                    name="hsg-url"/>
                <!-- end required facets and fields -->
            </text>
        </lucene>
        <range>
            <create match="//trip">
                <field match="@who" name="trip-who" type="xs:string"/>
            </create>
            <create qname="country" type="xs:string"/>
        </range>
    </index>
</collection>
